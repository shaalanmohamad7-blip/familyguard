<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. The UI itself is entirely Jetpack Compose (Material3); this
         XML theme only controls the window background shown for an instant before Compose
         takes over, and is not otherwise used for styling. -->
    <style name="Theme.FamilyGuard" parent="android:Theme.DeviceDefault.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/launcher_background</item>
    </style>
</resources>
